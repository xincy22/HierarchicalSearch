# Copy to .env and fill in the values you need.

# Core backend switches
HS_DATABASE_URL=sqlite:///hierarchical_search.db
HS_VECTOR_BACKEND=local
HS_LOCAL_VECTOR_PATH=hierarchical_vectors.db
HS_EMBEDDING_BACKEND=hash
HS_LLM_BACKEND=openai

# LLM / Embedding provider
OPENAI_API_KEY=
HS_OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
HS_OPENAI_CHAT_MODEL=GLM-4.7-Flash
HS_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional tuning
HS_DOC_TOP_K=20
HS_SECTION_TOP_K=50
HS_LLM_RERANK_ENABLED=true
